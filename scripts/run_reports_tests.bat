@echo off
REM =====================================================
REM سكريبت تشغيل جميع اختبارات تبويب التقارير
REM =====================================================

echo ========================================
echo بدء تشغيل اختبارات تبويب التقارير
echo ========================================
echo.

REM الانتقال إلى مجلد المشروع
cd /d %~dp0\..

REM اختبار تدفق البكسل
echo.
echo ========================================
echo [1/4] تشغيل اختبار تدفق البكسل
echo ========================================
flutter test test/reports_tab_pixel_flow_test.dart
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo ❌ فشل اختبار تدفق البكسل
    exit /b 1
)
echo ✅ نجح اختبار تدفق البكسل
echo.

REM اختبار التكامل
echo ========================================
echo [2/4] تشغيل اختبار التكامل
echo ========================================
flutter test test/reports_tab_integration_test.dart
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo ❌ فشل اختبار التكامل
    exit /b 1
)
echo ✅ نجح اختبار التكامل
echo.

REM اختبار الأداء
echo ========================================
echo [3/4] تشغيل اختبار الأداء
echo ========================================
flutter test test/reports_tab_performance_test.dart
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo ❌ فشل اختبار الأداء
    exit /b 1
)
echo ✅ نجح اختبار الأداء
echo.

REM الاختبار الشامل
echo ========================================
echo [4/4] تشغيل جميع الاختبارات معاً
echo ========================================
flutter test test/reports_tab_*.dart
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo ❌ فشل بعض الاختبارات
    exit /b 1
)

echo.
echo ========================================
echo ✅ تم إكمال جميع الاختبارات بنجاح
echo ========================================
echo.

pause


