{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Flutter Debug (Hot Reload Enabled)",
                "request": "launch",
                "type": "dart",
                "program": "lib/main.dart"
            },
            {
                "name": "Flutter Debug (No Hot Reload)",
                "request": "launch",
                "type": "dart",
                "program": "lib/main.dart",
                "args": [
                    "--no-hot"
                ]
            },
            {
                "name": "Flutter Profile Mode",
                "request": "launch",
                "type": "dart",
                "program": "lib/main.dart",
                "flutterMode": "profile",
                "args": [
                    "--no-hot"
                ]
            },
            {
                "name": "Flutter Release Mode",
                "request": "launch",
                "type": "dart",
                "program": "lib/main.dart",
                "flutterMode": "release"
            }
        ]
    }