rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for authentication
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Products collection (used by main-products)
    match /products/{productId} {
      allow read, write: if isAuthenticated();
      
      allow create: if isAuthenticated() 
        && request.resource.data.keys().hasAll(['name', 'retail_price'])
        && request.resource.data.name is string
        && request.resource.data.retail_price is number
        && request.resource.data.retail_price >= 0;
        
      allow update: if isAuthenticated() 
        && request.resource.data.keys().hasAll(['name', 'retail_price'])
        && request.resource.data.name is string
        && request.resource.data.retail_price is number
        && request.resource.data.retail_price >= 0;
    }
    
    // Quantities collection (used by main-products, needed by sales-analytics as backup)
    match /quantities/{quantityId} {
      allow read, write: if isAuthenticated();
      
      allow create: if isAuthenticated() 
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0;
        
      allow update: if isAuthenticated() 
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0;
    }
    
    // Inventory collection (used by main-products)
    match /inventory/{inventoryId} {
      allow read, write: if isAuthenticated();
    }
    
    // Sales collection (used by sales-analytics)
    match /sales/{saleId} {
      allow read, write: if isAuthenticated();
    }
    
    // Users collection (used by users-settings)
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }
    
    // Settings collection (used by users-settings)
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
    
    // Sessions collection (used by users-settings)
    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }
    
    // Audit logs (all projects)
    match /audit_logs/{auditId} {
      allow read, write: if isAuthenticated();
    }
    
    // Alerts (all projects)
    match /inventory_alerts/{alertId} {
      allow read, write: if isAuthenticated();
    }
    
    // Alert settings (all projects)
    match /alert_settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
    
    // Catch-all for other documents
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}